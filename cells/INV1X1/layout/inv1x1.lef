VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO inv1x1
  CLASS BLOCK ;
  FOREIGN inv1x1 ;
  ORIGIN 0.000 0.000 ;
  SIZE 2.300 BY 4.080 ;
  PIN A
    ANTENNAGATEAREA 0.441000 ;
    PORT
      LAYER li1 ;
        RECT 0.985 1.660 1.315 1.850 ;
      LAYER met1 ;
        RECT 1.000 1.600 1.300 1.920 ;
    END
  END A
  PIN Y
    ANTENNADIFFAREA 0.659400 ;
    PORT
      LAYER li1 ;
        RECT 0.845 2.870 1.015 3.330 ;
        RECT 0.825 0.490 0.995 1.370 ;
        RECT 1.785 0.490 1.955 1.370 ;
      LAYER met1 ;
        RECT 0.815 3.260 1.045 3.310 ;
        RECT 0.740 2.880 1.100 3.260 ;
        RECT 0.720 2.210 2.060 2.590 ;
        RECT 0.720 1.010 1.100 1.390 ;
        RECT 1.680 1.010 2.060 1.390 ;
        RECT 0.795 0.510 1.025 1.010 ;
        RECT 1.755 0.510 1.985 1.010 ;
