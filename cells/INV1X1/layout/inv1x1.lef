        RECT 0.720 1.010 1.110 3.260 ;
        RECT 1.680 1.010 2.060 2.590 ;
    END
  END Y
  PIN VDD
    ANTENNADIFFAREA 0.684400 ;
    PORT
      LAYER nwell ;
        RECT -0.230 1.870 2.530 4.410 ;
      LAYER li1 ;
        RECT 0.210 3.915 2.090 4.245 ;
        RECT 1.285 2.870 1.455 3.330 ;
      LAYER met1 ;
