// 04_characterization stage flow chart; render with: dot -Tsvg 04_characterization.dot | rsvg-convert -z 2 -b white -o 04_characterization.png
digraph g {
 graph [rankdir=LR, nodesep=0.25, ranksep=0.3, bgcolor="white", pad=0.2];
 node [fontname="Helvetica", fontsize=12, color="black", fontcolor="black", penwidth=1.2];
 edge [color="black", arrowsize=0.7, penwidth=1.1];
 in [shape=box, style="rounded,dashed", label="<cell>_pex.spice"];
 out [shape=box, style="rounded,dashed", label="lib/, datasheets/"];
 n0 [shape=box, width=1.5, height=0.6, label="FO4 point\nload and slew"];
 in -> n0;
 n1 [shape=box, width=1.5, height=0.6, label="Timing\nlctime, seqchar"];
 n0 -> n1;
 n2 [shape=box, width=1.5, height=0.6, label="Power + leakage\nngspice"];
 n1 -> n2;
 n3 [shape=box, width=1.5, height=0.6, label="Liberty\n+ datasheets"];
 n2 -> n3;
 n3 -> out;
}
